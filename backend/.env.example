# PostgreSQL connection string supplied by Supabase or another PostgreSQL provider.
DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
JWT_SECRET=
# Optional. Defaults to 15m when not provided.
JWT_EXPIRES_IN=
# Local frontend origin allowed by CORS. Defaults to http://localhost:5173.
CORS_ORIGIN=http://localhost:5173
# API key for server-side openrouteservice cycling routing. Never expose it to the frontend.
ORS_API_KEY=
