# PostgreSQL connection string supplied by Supabase or another PostgreSQL provider.
DATABASE_URL=
# SMTP credentials for the Gmail account dedicated to the TFM. Use an app password, never its normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-project-email@gmail.com
SMTP_APP_PASSWORD=your-google-app-password
EMAIL_FROM="CicloViento <your-project-email@gmail.com>"
# Kept as a future alternative. It is not the active provider in this phase.
RESEND_API_KEY=
JWT_SECRET=
# Optional. Defaults to 15m when not provided.
JWT_EXPIRES_IN=
# Local frontend origin allowed by CORS. Defaults to http://localhost:5173.
CORS_ORIGIN=http://localhost:5173
# API key for server-side openrouteservice cycling routing. Never expose it to the frontend.
ORS_API_KEY=
